# ---------------------------------------------------------------------------
# BahiBooks ERP - environment config
# Copy this file to `.env` and edit values. Never commit the real .env.
# ---------------------------------------------------------------------------

# Server port
PORT=4000

# Data folder (SQLite master.db + companies/). Default: ./data
# Online/server par absolute path do, e.g. /data
# BAHI_DATA_DIR=/data

# Access mode:
#   auto    = localhost se full desktop access, network se limited web entry (default)
#   desktop = hamesha full access (sirf trusted local machine ke liye)
#   web     = hamesha web mode (network deployment ke liye)
#   full    = poora ERP sab jagah (online full-access mode)
ACCESS_MODE=web

# Online par web me bhi poore features (reports, masters, GST, admin) chahiye to true
WEB_FULL_ACCESS=true

# JWT signing secret. Set na karne par server data/secret.key auto-generate karta hai.
# Production me strong random value zaroor do:  openssl rand -hex 48
JWT_SECRET=change-this-to-a-long-random-string

# Node env
NODE_ENV=production

# ---------------------------------------------------------------------------
# Online (docker compose) deployment ke liye
# ---------------------------------------------------------------------------
# Aapka domain. Khaali chhodo to plain HTTP (port 80) par chalega.
# Domain do (DNS A record server IP par point ho) to HTTPS auto mil jayega.
# DOMAIN=erp.aapkicompany.com
