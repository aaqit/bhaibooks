{
  "name": "tally-erp",
  "version": "1.0.0",
  "private": true,
  "description": "BahiBooks ERP - Tally Prime style multi-company accounting (web + PC desktop)",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"node --watch server/index.js\" \"npm --prefix client run dev -- --host\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "client": "npm --prefix client run dev -- --host",
    "server": "node --watch server/index.js",
    "setup": "npm install && npm --prefix client install",
    "desktop": "npm run build && electron .",
    "desktop:only": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.bahibooks.erp",
    "productName": "BahiBooks ERP",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**",
      "client/dist/**",
      "node_modules/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BahiBooks ERP"
    },
    "portable": {
      "artifactName": "BahiBooks-ERP-Portable-${version}.exe"
    }
  }
}
